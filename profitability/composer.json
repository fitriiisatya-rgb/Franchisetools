    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "ext-xml": "*",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "lib/"
        }
    },
    "config": {
        "optimize-autoloader": true
